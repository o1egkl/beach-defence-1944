{
  "name": "pacific-defence",
  "productName": "Pacific Defence",
  "version": "1.1.0",
  "description": "3D First-Person Coastal Bunker Defense Arcade Game",
  "main": "main.js",
  "author": "Oleg",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pacificdefence.game",
    "productName": "Pacific Defence",
    "copyright": "Copyright © 2026 Pacific Defence",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pacific Defence"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "manifest.json",
      "sw.js",
      "favicon.ico",
      "favicon.png",
      "lib/**/*",
      "models/**/*",
      "icons/**/*"
    ]
  }
}
